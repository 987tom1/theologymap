    { "source": "/edit", "destination": "/engine/editor.html?mode=hosted" },
    { "source": "/gallery", "destination": "/web/gallery.html" },
    { "source": "/history", "destination": "/web/history.html" },
    { "source": "/view", "destination": "/web/view.html" },
    { "source": "/admin", "destination": "/web/admin.html" },
    { "source": "/wizard", "destination": "/web/wizard.html" },
    { "source": "/learn", "destination": "/web/learn.html" },
    { "source": "/compare", "destination": "/web/compare.html" }
